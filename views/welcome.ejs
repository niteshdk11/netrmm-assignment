<%- include('partials/head') %>

  <div class="w-full max-w-md mx-auto mt-10">
    <div class="bg-white rounded-lg shadow-md p-8">
      <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Welcome!</h1>

      <p class="text-gray-600 text-center mb-6">
        Thank you for registering on our platform! Please check your email to verify your account.
      </p>

      <% if (error) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
          <%= error %>
        </div>
        <% } %>

          <% if (success) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
              <%= success %>
            </div>
            <% } %>

              <form action="/verify-email" method="POST">
                <input type="hidden" name="email" value="<%= email %>">

                <div class="mb-4">
                  <label for="otp" class="block text-gray-700 text-sm font-bold mb-2">Enter OTP</label>
                  <input type="text" id="otp" name="otp" required
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    placeholder="Enter the 6-digit OTP">
                </div>

                <button type="submit"
                  class="w-full bg-blue-600 text-white font-bold py-2 px-4 rounded-md hover:bg-blue-700 transition duration-300">
                  Verify Email
                </button>
              </form>

              <div class="text-center mt-4">
                <a href="/login" class="text-sm text-blue-600 hover:underline">Back to Login</a>
              </div>
    </div>
  </div>

  <%- include('partials/footer') %>